{
  "expo": {
    "name": "Cricbook",
    "slug": "cricbook-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "permissions": ["POST_NOTIFICATIONS", "USE_BIOMETRIC", "USE_FINGERPRINT"]
    }
  }
}
